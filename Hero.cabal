cabal-version:      3.4
name:               Hero
version:            0.0.0.1
synopsis:           Initialize, check, and fix my project.
-- description:
homepage:           https://github.com/Censera/Hero
license:            Apache-2.0
license-file:       LICENSE
author:             Censera
maintainer:         Censera@proton.me
